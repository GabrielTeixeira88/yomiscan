{
  "manifest_version": 3,
  "name": "YomiScan — Local Manga Study & Reading",
  "version": "0.1.0",
  "description": "Study Japanese text or progressively translate supported image-based manga readers using a local backend.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "offscreen"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "YomiScan: Study / Translate Chapter"},
  "commands": {
    "select-text": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Select Japanese text (Study Mode)"}
  },
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http: https:"}
}
