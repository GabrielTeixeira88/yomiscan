{
  "manifest_version": 3,
  "name": "YomiScan — Local Manga Study",
  "version": "0.1.0",
  "description": "Select a Japanese text region and study it using your local YomiScan backend.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "YomiScan: select a Japanese text region"},
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}
  },
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8765"}
}
